<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ClipX has no third-party NuGet dependencies. Keeping restore offline also
       makes reproducible builds possible on clean Windows machines. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
